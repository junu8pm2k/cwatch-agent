      "source": "github_api",
      "response": {
        "status": 403,
        "headers": {
          "x-ratelimit-remaining": "42"
        },
        "body": {
          "message": "Resource not accessible by integration"
        }
      },
      "steps": [],
      "modelMode": "pi_session",
      "maxTokens": 30000,
      "maxOutputTokens": 2048,
      "toolTimeoutMs": 5000
    },
    "materialProvenance": "合成HTTP故障对照，不是生产事故；标签待核验。"
  },
