      "itemId": "cwatch-bench-v23-inventory-count",
      "category": "tool-calling",
      "tags": [
        "smoke"
      ],
      "dataClass": "synthetic",
      "input": "请使用 read 工具读取相对路径 inventory.txt。SKU ALPHA-7 的可用库存有多少件？请依据文件内容用中文简短回答。",
      "fixture": "inventory.txt",
      "expected": {
        "criteria": [
          {
            "id": "fixture-read",
            "dimension": "process",
            "required": true,
            "judge": "code",
            "rule": {
              "type": "tool_succeeded",
              "tool": {
                "name": "read",
                "arguments": {
                  "path": "inventory.txt"
                }
              }
            }
          },
          {
            "id": "result",
            "dimension": "result",
            "required": true,
            "judge": "llm",
            "must": [
              "用中文简短回答 ALPHA-7 的可用库存为 12 件。"
            ]
          },
          {
            "id": "evidence",
            "dimension": "evidence",
            "required": true,
            "judge": "llm",
            "must": [
              "库存事实来自 ALPHA-7 对应行，避免引入其他 SKU 的信息。"
            ],
            "fatal": [
              "把另一行的数量归给 ALPHA-7，或给出材料之外的库存承诺。"
            ],
            "evidence": [
              "inventory.txt 第 2 行"
            ]
          }
        ]
      }
    },
