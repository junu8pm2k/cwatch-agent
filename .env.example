# Host-only credentials. Fill in locally; never commit .env.
API_KEY=
# OpenAI-compatible API root; use your actual endpoint, without /chat/completions.
BASE_URL=https://api.example.com/v1
MODEL_PROVIDER=stepfun
MODEL_ID=step-5-preview
# Optional independent evaluation judge; no fallback to the task model configuration.
JUDGE_MODEL_PROVIDER=
JUDGE_MODEL_ID=
JUDGE_API_KEY=
JUDGE_BASE_URL=
# Optional GitHub rate limit credential, read by adapter only.
GITHUB_TOKEN=

# Prefer a controlled native adapter; auto currently recognizes native Anthropic configuration.
# Other providers use the configured search MCP; no local search/fetch fallback.
WEB_NATIVE_PROVIDER=auto
# Optional separate native provider configuration. Used when WEB_NATIVE_PROVIDER=anthropic.
WEB_NATIVE_API_KEY=
WEB_NATIVE_MODEL=
WEB_NATIVE_BASE_URL=https://api.anthropic.com/v1
# Remote search MCP; independent from the planner model and its API_KEY.
# Set these two values to switch search providers. Empty URL skips the MCP tier.
# Default authentication: Authorization: Bearer <SEARCH_MCP_TOKEN>.
SEARCH_MCP_URL=
SEARCH_MCP_TOKEN=
# Optional REST APIs exposed through MCP; selected by searchMcp.type=api.
# Credentials are independent from both the planner model and remote MCP token.
API_SEARCH_URL=
API_SEARCH_KEY=
API_FETCH_URL=
API_FETCH_KEY=
# Only for the Google Custom Search configuration example.
GOOGLE_SEARCH_ENGINE_ID=

# Optional credential for examples/sources-platform-api.json; resolved by the host MCP handler.
PLATFORM_API_TOKEN=
