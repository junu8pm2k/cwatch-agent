# Host-only credentials. Fill in locally; never commit .env.
API_KEY=
# OpenAI-compatible API root; use your actual endpoint, without /chat/completions.
BASE_URL=https://api.example.com/v1
MODEL_PROVIDER=stepfun
MODEL_ID=step-5-preview
# Optional independent evaluation judge; no fallback to the task model configuration.
JUDGE_MODEL_PROVIDER=
JUDGE_MODEL_ID=
JUDGE_API_KEY=
JUDGE_BASE_URL=
# Optional GitHub rate limit credential, read by adapter only.

# Controlled native web adapter, used only when no external search tool URL is configured.
# auto recognizes official Anthropic, OpenAI, and Gemini model configurations; off disables native web tools.
WEB_NATIVE_PROVIDER=auto
# Optional separate native provider configuration. Used when WEB_NATIVE_PROVIDER=anthropic|openai|gemini.
WEB_NATIVE_API_KEY=
WEB_NATIVE_MODEL=
WEB_NATIVE_BASE_URL=https://api.anthropic.com/v1
# External search tool URL + key; prioritized ahead of native web tools when configured.
# Automatically compatible with remote MCP (Streamable HTTP / SSE) and mainstream REST APIs
# (Tavily, Exa, Brave, Serper, SerpAPI, Bocha, Firecrawl, Jina, Google CSE, Perplexity, Metaso, generic REST).
# Default authentication: Authorization: Bearer <SEARCH_MCP_TOKEN>. Independent from model API_KEY.
SEARCH_MCP_URL=
SEARCH_MCP_TOKEN=
# Optional separate REST search/fetch endpoints; used by explicit webApi or as fallback when SEARCH_MCP_URL is empty.
# Credentials are independent from both the planner model and remote MCP token.
API_SEARCH_URL=
API_SEARCH_KEY=
API_FETCH_URL=
API_FETCH_KEY=
# Only for the Google Custom Search configuration example.
GOOGLE_SEARCH_ENGINE_ID=

# Optional credential for examples/sources-platform-api.json; resolved by the host MCP handler.
PLATFORM_API_TOKEN=

# Langfuse: fill both project keys to enable live-run export; false disables export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Instance root (EU shown); US: https://us.cloud.langfuse.com; local: use the host port published by Compose (e.g. http://localhost:3002).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TIMEOUT_MS=5000
# LANGFUSE_ENABLED=false

# Optional: use a previously pulled, frozen Agent prompt snapshot for live CLI/Web runs.
# CWATCH_AGENT_PROMPT_SNAPSHOT=artifacts/agent-prompts/current.json
