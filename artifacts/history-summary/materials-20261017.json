  "claims": [
    {
      "id": "claim-ci-design-access-source",
      "basis": "scenario_design",
      "wording": "**竞品来源 MCP Hub** 设计由 SourceServerBuilder 装配 MCP 与 API 的来源契约，池内发现工具并按原名派发，来源 Adapter 映射为 CompetitorSignal；将协议适配与实体、证据、时间字段归一分层。"
    },
    {
      "id": "claim-ci-design-harness-permission",
      "basis": "scenario_design",
      "wording": "**竞品采集 Tool Calling 门禁** 选择执行前裁决承载 ActionPolicy，分析 runPreToolUseChecks 的模式、来源与审批分支，按 pre_tool_use_response 控制调用；为采集、修改和外发定义参数规则及拒绝后无执行的验收。"
    },
    {
      "id": "claim-ci-design-harness-context",
      "basis": "scenario_design",
      "wording": "**竞品任务 Context Engineering** 设计 CompetitorTask 的实体、时间窗与来源范围，复用 BaseAgent.chat 的技能前置处理；以 buildStableContextParts 装配稳定块，buildVolatileContextParts 承载当轮任务和来源状态。"
    },
    {
      "id": "claim-ci-design-runtime-cancel",
      "basis": "scenario_design",
      "wording": "**竞品采集 Agent Runtime 取消** 针对取消调研时的挂起审批，分析 requestId 关联与 handleAbort 的 block 清理，设计 ExecutionRecord 区分权限等待、执行中和取消状态；采集缺口保留未知，避免误报成功或副作用已回滚。"
    },
    {
      "id": "claim-ci-design-eval-semantic",
      "basis": "scenario_design",
      "wording": "**竞品事实 Agent Eval** 以 CompetitorSignal 的官网与转载快照规划 EvalCase，按实体、事实数、证据和双时点设置断言；将归因、去重、时间窗评测与 routing.test.ts 的底座契约回归分开。"
    }
  ],
