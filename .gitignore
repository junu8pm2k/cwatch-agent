# Logs, temporary files, editor and operating-system metadata
*.log
*.tmp
*.swp
*.swo
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# User-managed MCP configuration and installed third-party skills
.cwatch/
# Keep legacy local configuration ignored after the rename.
.cint/

# Compact real browser protocol acceptance report
!/artifacts/browser-eval/
/artifacts/browser-eval/*
!/artifacts/browser-eval/latest.json
!/artifacts/browser-eval/latest.md

# Compact local Web workbench acceptance evidence
!/artifacts/web-eval/
/artifacts/web-eval/*
!/artifacts/web-eval/latest.json
!/artifacts/web-eval/latest.md
