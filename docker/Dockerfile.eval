FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv
FROM node:24.21.0-trixie@sha256:1278a37eb510ec1606fba0e80f554bcc941ae0b44f35ae373c4822ae7717c64d

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
WORKDIR /workspace

COPY package.json package-lock.json pyproject.toml uv.lock .python-version ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && uv python install \
    && uv sync --locked

COPY evals ./evals
COPY skills/general-agent ./skills/general-agent
COPY skills/competitor-review ./skills/competitor-review
CMD ["uv", "run", "--locked", "--no-sync", "pytest", "-p", "no:deepeval", "-q", "--durations=10", "evals/test_agent.py"]
